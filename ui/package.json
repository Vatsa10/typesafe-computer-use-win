{
  "name": "winclicker",
  "version": "0.1.0",
  "description": "Cheap, fast computer use on Windows",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ai.typesafe.winclicker",
    "productName": "winclicker",
    "files": ["src/**/*"],
    "extraResources": [{ "from": "../rust/target/release/winclicker-core.exe", "to": "core.exe" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
